# Database (Supabase: use the *Session pooler* connection string)
DATABASE_URL="postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Better Auth
# Generate with: openssl rand -base64 32   (must be 32+ characters)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# GitHub OAuth app (github.com/settings/developers)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
