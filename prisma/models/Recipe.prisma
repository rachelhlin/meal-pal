model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  ingredients  String
  instructions String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[] @relation("RecipeReviews")
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
}
