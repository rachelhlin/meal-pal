model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  recipeId  Int
  recipe    Recipe   @relation("RecipeReviews", fields: [recipeId], references: [id])
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([authorId])
}
